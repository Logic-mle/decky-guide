{
  "name": "decky-guide",
  "version": "0.6.5",
  "description": "Read Gamersky game guides from the Decky Loader quick access menu.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "rollup -c -w",
    "test": "tsc --noEmit && node --test tests/reading-state.test.mjs",
    "preview": "node scripts/preview.mjs --serve",
    "test:browser": "node tests/reader-browser.mjs"
  },
  "keywords": [
    "decky",
    "steam-deck",
    "gamersky",
    "guides"
  ],
  "author": "Leo Wu",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "react-dom": "^19.2.8",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
